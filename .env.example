# Dev database. Local Postgres, or Neon (direct string for migrations, pooled for Lambda).
DATABASE_URL=postgresql+psycopg://encore:change-me@localhost:5432/encore
# Tests truncate every table, so this must be a dedicated local database.
# docker compose up -d db exposes one at localhost:5433 (user and password: encore).
TEST_DATABASE_URL=postgresql+psycopg://encore_test:change-me@localhost:5432/encore_test

# Frontend origin allowed by CORS. SERVE_FRONTEND=true also serves frontend/ from the API (local and ngrok demos).
FRONTEND_ORIGIN=http://localhost:8000
SERVE_FRONTEND=true

# Business rules
MIN_LEAD_DAYS=2
WEEKENDS_AHEAD=8

# Admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
# Behind ngrok in dev: trust the proxy's X-Forwarded-For. Leave false on Lambda.
TRUST_PROXY_HEADERS=false

# Square sandbox (Developer Console > your app > Sandbox). Never live keys in this file.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=EAAAl-fake-sandbox-token
SQUARE_LOCATION_ID=LFAKELOCATION
# Webhook subscription for payment.created and payment.updated. The URL must match the dashboard exactly.
SQUARE_WEBHOOK_SIGNATURE_KEY=fake-signature-key
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-static-domain.ngrok-free.app/api/webhooks/square
# Local only: with SQUARE_ACCESS_TOKEN empty, checkout becomes a fake page that sends a signed webhook to this API.
DEV_FAKE_SQUARE=false
