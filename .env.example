# Every key here is also a Lambda environment variable on the deploy, set by Terraform from
# infra/terraform.tfvars (gitignored). Nothing in this file ships in the deployment zip.

# Dev database. Local Postgres, or Neon (direct string for migrations, pooled for Lambda).
# Both URLs below match docker compose up -d db.
DATABASE_URL=postgresql+psycopg://encore:encore@localhost:5433/encore
# Tests truncate every table, so this must be a dedicated local database.
# docker compose up -d db exposes one at localhost:5433 (user and password: encore).
TEST_DATABASE_URL=postgresql+psycopg://encore:encore@localhost:5433/encore_test

# Frontend origin allowed by CORS, and what Square's checkout redirects back to. SERVE_FRONTEND=true
# serves frontend/ from the API: that is how local, ngrok AND the Lambda deploy all run, so the whole
# system is one origin and the admin cookie is never third-party. On Lambda both of these are set from
# infra's public_base_url, so they cannot drift from the address the system actually answers on.
FRONTEND_ORIGIN=http://localhost:8000
SERVE_FRONTEND=true

# Business rules
MIN_LEAD_DAYS=2
# How the receipt states tax. included: prices already include it (the receipt says so).
# line_item: a Sales tax line is added to every quote at TAX_RATE_PERCENT (New Rochelle is 8.375).
TAX_MODE=included
TAX_RATE_PERCENT=0
# open: weekends bookable online. request: every date is request-only.
WEEKEND_DEFAULT=open
# The weekday-request door. Off: POST /api/requests answers 404. The funnel offers no request step in
# v1, and the admin list keeps working either way, so nothing taken earlier is lost.
REQUESTS_ENABLED=false
# Root log level. INFO locally; the deploy sets WARNING so CloudWatch only ingests what matters.
LOG_LEVEL=INFO
WEEKENDS_AHEAD=8
# How long before the party self-serve add-on additions close. The food has to be ordered, so confirm
# this number with the owner before launch.
ADDON_CUTOFF_HOURS=48
# How many deposits may refund themselves in one day before the rest queue for the owner to approve.
REFUND_DAILY_CAP=3
# The demo reset endpoint deletes bookings, so it stays off until deliberately turned on. It also
# refuses outright against production Square credentials. Set it true on the demo machine.
DEMO_RESET_ENABLED=false
# Holds cost nothing to make and lock revenue. Creation is capped per IP per rolling hour (holds a
# browser swapped away do not count, so changing your mind is free), and a browser that lets two holds
# lapse on the same date waits this long before taking that date again.
HOLD_RATE_PER_HOUR=5
HOLD_COOLDOWN_MINUTES=45

# Admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
# Behind ngrok in dev: trust the proxy's X-Forwarded-For. False on Lambda, where nothing trusted sits in
# front of the Function URL and the real address arrives on the event as requestContext.http.sourceIp.
TRUST_PROXY_HEADERS=false

# Square sandbox (Developer Console > your app > Sandbox). Never live keys in this file.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=EAAAl-fake-sandbox-token
# Public by design: the browser needs it to tokenize a card with the Web Payments SDK. It identifies the
# application and grants nothing. Leave it empty and the funnel has no card fields, which is the local
# path: DEV_FAKE_SQUARE then books without touching Square at all.
SQUARE_APPLICATION_ID=sandbox-sq0idb-fake-application-id
SQUARE_LOCATION_ID=LFAKELOCATION
# Webhook subscription for payment.created, payment.updated, refund.created and refund.updated. The
# signature is HMAC over (this URL + the raw body), so it must match the dashboard character for
# character or every delivery is a 401. On Lambda it is <function url>/api/webhooks/square.
SQUARE_WEBHOOK_SIGNATURE_KEY=fake-signature-key
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-static-domain.ngrok-free.app/api/webhooks/square
# Local only: with SQUARE_ACCESS_TOKEN empty, the pay endpoint books without calling Square, so the funnel
# works end to end with no credentials. Leave this false anywhere real: the demo takes a sandbox test card
# through the card fields on our own page.
DEV_FAKE_SQUARE=false
# The test-mode ribbon on every page. Unset, it follows SQUARE_ENVIRONMENT: on for sandbox, off for production.
# Set it only to override that; sandbox should never be demoed without the notice.
TEST_MODE=
# Cloudflare Turnstile on the Confirm action. Off by default; the funnel loads no Cloudflare script while it is.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Twilio trial SMS. Leave any of the three empty to log messages to the console instead of sending.
TWILIO_ACCOUNT_SID=ACfake00000000000000000000000000
TWILIO_AUTH_TOKEN=fake-auth-token
TWILIO_FROM_NUMBER=+15005550006
# Owner's phone for NEW PARTY texts (must be a verified number on a Twilio trial).
OWNER_PHONE=+15555550100
# Google review link for the (not yet scheduled) review-request text.
GOOGLE_REVIEW_URL=https://g.page/r/fake-review-link/review
# Optional owner channel. The URL is a secret: it is never stored or logged.
DISCORD_WEBHOOK_URL=
# Parent confirmation email over SMTP (any provider's relay). Leave any of the four empty to log the email instead.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=fake-smtp-user
SMTP_PASSWORD=fake-smtp-password
EMAIL_FROM=Encore Esports <bookings@example.com>
